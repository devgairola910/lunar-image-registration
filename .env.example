# ChandraDrishti Frontend Environment Variables
# Copy this file to .env or set these in your Vercel Environment Variables configuration.

# AWS / Production Backend API URL (Must start with VITE_)
VITE_API_URL=https://your-aws-backend-domain.com

# Alternatively, you can use VITE_BACKEND_URL or VITE_AWS_API_URL
# VITE_BACKEND_URL=https://your-aws-backend-domain.com
